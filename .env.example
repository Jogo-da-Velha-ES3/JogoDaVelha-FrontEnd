# REST do back: todas as rotas têm o prefixo /api (contrato-integracao.md do back)
VITE_API_URL=http://localhost:8080/api
# Base do back; o cliente STOMP usa ws(s)://<host>/ws
VITE_WEBSOCKET_URL=http://localhost:8080

# Servidor simulado (FE-35): ligado por padrão até o cliente STOMP real (FE-18)
VITE_USE_MOCK_SERVER=true
# normal | vitoria | empate-absoluto | morte-subita | wo (?cenario= na URL tem prioridade)
VITE_MOCK_SCENARIO=normal
# O que o robô faz no Resultado: aceita, recusa, ignora, pede, sai
VITE_MOCK_REMATCH=aceita